#!/bin/bash
# stub: `globus transfer` copies $FAKE_SRC/<src>/*gbw* to <dest>; task wait/show succeed.
S="${STUB_STATE:?}"; mkdir -p "$S"
case "$1 ${2:-}" in
  "transfer "*)
    batch=""; args=("$@")
    for ((i=0;i<${#args[@]};i++)); do [[ ${args[$i]} == --batch ]] && batch="${args[$((i+1))]}"; done
    n=$(( $(cat "$S/globus_count" 2>/dev/null || echo 0) + 1 )); echo $n > "$S/globus_count"
    while read -r src dest rest; do
        mkdir -p "$dest"; cp "$FAKE_SRC/$src"/*gbw* "$dest"/ 2>/dev/null
        echo "$src" >> "$S/globus_sources"
    done < "$batch"
    echo "task-$n" ;;
  "task wait") exit 0 ;;
  "task show") cat "$S/globus_status" 2>/dev/null || echo SUCCEEDED ;;
esac
